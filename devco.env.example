# ---------------------------------------------------------------------------
# devco.env — the ONE place machine-specific values live.
#
# Copied to /opt/devco/devco.env by install-base.sh (the unattended bootstrap
# fills in DEVCO_USER and DEVCO_LAN_IP). Every script in this package sources it.
# Adding Athena later means changing the llama-swap config, not touching agents.
#
# This file is committed as an EXAMPLE only. The real /opt/devco/devco.env is
# never committed (it is outside the repo and also gitignored by name).
# NOT for secrets: it is readable by every agent on the box. See SECRETS.md.
# ---------------------------------------------------------------------------

# The Linux user that runs everything (llama-swap, Paperclip, Hermes, the agents).
# Must match the user you log in as when you run the install scripts.
DEVCO_USER="${USER:-$(id -un)}"

# LAN IP of this box (the MS-S1 Max). Used for Paperclip's allowed hostname and
# for the links the setup prints. The bootstrap detects and writes it.
DEVCO_LAN_IP="10.86.86.20"

# Where repos the agents work on live. Each project is a git clone here.
DEVCO_REPOS="/opt/devco/repos"

# Where GGUF model files live.
DEVCO_MODELS="/opt/models"

# Name of the company in Paperclip (create-company.sh looks it up by this name).
DEVCO_COMPANY_NAME="Spidersnet Dev Co."

# ---- GitHub ---------------------------------------------------------------
# The organization that owns every project repo and this infra repo.
GITHUB_ORG="spidersnet-devco"

# The machine-user account the AGENTS push and open PRs as (never Geoff's own).
# Create it on github.com with its own email + 2FA, invite it to the org as a
# Member. github-setup.sh signs this box in as that account.
GITHUB_TEAM="agents"                     # org team the bot is in; gets Write on every project repo
GITHUB_BOT_USER="spidersnet-devco-bot"
GITHUB_BOT_EMAIL="devco-bot@spidersnet.net"
# The bot's GitHub no-reply address, used as git author so the real email never
# appears in commit history. Find it at github.com/settings/emails while logged
# in AS THE BOT, after ticking "Keep my email addresses private".
# Format: <id>+spidersnet-devco-bot@users.noreply.github.com
GITHUB_BOT_NOREPLY=""

# Where the nightly mirror of every org repo lands: a NAS share MOUNTED on this box
# (the mirror script refuses an unmounted path unless GIT_MIRROR_REQUIRE_MOUNT=0).
# Leave empty to skip mirroring. Backups (devco backup) go next to it by default.
GIT_MIRROR_DIR="/mnt/nas/backups/git-mirror"
#DEVCO_BACKUP_DIR="/mnt/nas/backups/devco-backups"

# ---- Model gateway ---------------------------------------------------------
# All agents talk to the model gateway by ROLE ALIAS, never by model name:
#   coder-accurate  -> the best local model (today: gpt-oss-120b MXFP4)
#   coder-fast      -> the fast lane        (today: Qwen3.6-35B-A3B UD-Q4_K_XL)
# llama-swap serves both on one port. Expansion = point an alias elsewhere.
MODEL_GATEWAY_URL="http://127.0.0.1:8080/v1"
MODEL_GATEWAY_KEY="no-key-required"

# Pin versions (empty = newest at install time; what got installed is recorded in
# /opt/devco/versions.txt and should be copied into NOTES.md).
LLAMACPP_TAG=""                 # e.g. b7812  (git tag in ggml-org/llama.cpp)
LLAMA_SWAP_VERSION=""           # e.g. 268    (no leading v)
PAPERCLIP_INSTALL_VERSION=""    # e.g. 2026.1023.0

# ---- Paperclip -------------------------------------------------------------
PAPERCLIP_URL="http://127.0.0.1:3100"

# ---- Hermes profiles --------------------------------------------------------
# name:description  (one profile per specialist; a folder of the same name must
# exist under 04-hermes/profiles/). No ports: Paperclip runs each profile directly.
HERMES_PROFILES=(
  "pyro:Python and PySide6 desktop apps; tests, packaging, scripts"
  "webby:Frontend and web: PWAs, single-file HTML apps, dashboards"
  "ops:Docker and Compose definitions, Unraid stack repos, CI, deploy scripts"
)

# ---- Expansion (Athena) -----------------------------------------------------
#ATHENA_MAC="aa:bb:cc:dd:ee:ff"           # for wake-athena.sh
#ATHENA_SSH="ops@athena.lan"              # restricted key, see sleep-athena.sh

# ---- This repo on the box -----------------------------------------------------
# Where devco-infra is checked out. `devco status` compares /opt/devco/bin and the agents'
# instructions against it, and `sudo devco install-bin` reinstalls the scripts from it.
# Default: /home/$DEVCO_USER/devco-infra.
#DEVCO_INFRA_DIR="/home/geoff/devco-infra"
