# ---------------------------------------------------------------------------
# devco.env — the ONE place machine-specific values live.
#
# Copy to /opt/devco/devco.env and edit. Every script in this package sources
# it. Adding Athena later means changing MODEL_GATEWAY_URL (or the llama-swap
# config) here, not touching every agent.
#
# This file is committed as an EXAMPLE only. The real /opt/devco/devco.env is
# never committed (it is outside the repo and also gitignored by name).
# ---------------------------------------------------------------------------

# The Linux user that runs everything (llama-swap, Paperclip, Hermes gateways).
# Must match the user you log in as when you run the install scripts.
DEVCO_USER="${USER}"

# LAN IP of this box (the MS-S1 Max). Used for Paperclip's allowed hostname and
# for the links the onboarding prompts contain.
DEVCO_LAN_IP="10.86.86.20"

# Where repos the agents work on live. Each project is a git clone here.
DEVCO_REPOS="/opt/devco/repos"

# Where GGUF model files live.
DEVCO_MODELS="/opt/models"

# ---- GitHub ---------------------------------------------------------------
# The organization that owns every project repo and this infra repo.
GITHUB_ORG="spidersnet-devco"

# The machine-user account the AGENTS push and open PRs as (never Geoff's own).
# Create it on github.com with its own email + 2FA, invite it to the org as a
# Member. github-setup.sh signs this box in as that account.
GITHUB_BOT_USER="spidersnet-devco-bot"
GITHUB_BOT_EMAIL="devco-bot@spidersnet.net"
# The bot's GitHub no-reply address, used as git author so the real email never
# appears in commit history. Find it at github.com/settings/emails while logged
# in AS THE BOT, after ticking "Keep my email addresses private".
# Format: <id>+spidersnet-devco-bot@users.noreply.github.com
GITHUB_BOT_NOREPLY=""

# Where the nightly mirror of every org repo lands (NAS share mounted on this box,
# or a local directory). Leave empty to skip mirroring.
GIT_MIRROR_DIR="/mnt/nas/backups/git-mirror"

# ---- Model gateway ---------------------------------------------------------
# All agents talk to the model gateway by ROLE ALIAS, never by model name:
#   coder-accurate  -> the best local model (today: gpt-oss-120b)
#   coder-fast      -> the fast lane        (today: Qwen3-Coder-30B-A3B)
# llama-swap serves both on one port. Expansion = point an alias elsewhere.
MODEL_GATEWAY_URL="http://127.0.0.1:8080/v1"
MODEL_GATEWAY_KEY="no-key-required"

# ---- Paperclip -------------------------------------------------------------
PAPERCLIP_URL="http://127.0.0.1:3100"

# ---- Hermes profiles --------------------------------------------------------
# name:port:description   (one profile per specialist; ports must be unique)
HERMES_PROFILES=(
  "pyro:8642:Python and PySide6 desktop apps; tests, packaging, scripts"
  "webby:8643:Frontend and web: PWAs, single-file HTML apps, dashboards"
  "ops:8644:Docker, Unraid stacks, reverse proxy, CI, deploy scripts"
)
