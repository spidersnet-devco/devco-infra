{
  "name": "pyro",
  "title": "Python & desktop engineer",
  "role": "engineer",
  "reportsTo": "__PRINCIPAL_ID__",
  "adapterType": "hermes_local",
  "adapterConfig": {
    "hermesCommand": "/opt/devco/bin/hermes-run",
    "model": "coder-accurate",
    "quiet": true,
    "persistSession": false,
    "timeoutSec": 3600,
    "maxTurnsPerRun": 80,
    "env": {
      "HERMES_HOME": "__HOME__/.hermes/profiles/pyro"
    }
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": false,
      "intervalSec": 300,
      "wakeOnDemand": true,
      "skipTimerWhenNoActionableWork": true,
      "cooldownSec": 10,
      "maxConcurrentRuns": 1
    }
  },
  "permissions": {
    "canCreateAgents": false,
    "canCreateSkills": false,
    "canAssignTasks": false
  },
  "instructions": [
    "AGENTS.md"
  ],
  "paused": false
}
