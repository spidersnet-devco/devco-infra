{
  "name": "Principal Engineer",
  "title": "Principal Engineer",
  "role": "engineer",
  "reportsTo": "__ARCHITECT_ID__",
  "adapterType": "claude_local",
  "adapterConfig": {
    "command": "__HOME__/.local/bin/claude",
    "engine": "cli",
    "model": "claude-opus-5-5",
    "effort": "high",
    "maxTurnsPerRun": 60
  },
  "runtimeConfig": {
    "heartbeat": {
      "enabled": false,
      "intervalSec": 300,
      "wakeOnDemand": true,
      "skipTimerWhenNoActionableWork": true,
      "cooldownSec": 10,
      "maxConcurrentRuns": 1
    }
  },
  "permissions": {
    "canCreateAgents": false,
    "canCreateSkills": false,
    "canAssignTasks": true
  },
  "instructions": [
    "AGENTS.md"
  ],
  "paused": false
}
